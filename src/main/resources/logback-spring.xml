<configuration>
    <springProperty name="applicationName" source="spring.application.name" defaultValue="mabillon"/>
    <springProperty name="rootLevel" source="logging.level.root" defaultValue="INFO"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.cayenne" level="WARN"/>
    <logger name="org.springframework.security" level="INFO"/>
    <root level="${rootLevel}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
